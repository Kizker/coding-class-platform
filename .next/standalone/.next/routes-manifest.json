{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/student/capstone/[id]",
      "regex": "^/student/capstone/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/student/capstone/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/student/curriculum/[week]",
      "regex": "^/student/curriculum/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPweek": "nxtPweek"
      },
      "namedRegex": "^/student/curriculum/(?<nxtPweek>[^/]+?)(?:/)?$"
    },
    {
      "page": "/student/learn/[week]/[day]",
      "regex": "^/student/learn/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPweek": "nxtPweek",
        "nxtPday": "nxtPday"
      },
      "namedRegex": "^/student/learn/(?<nxtPweek>[^/]+?)/(?<nxtPday>[^/]+?)(?:/)?$"
    },
    {
      "page": "/student/live-session/[week]/[day]",
      "regex": "^/student/live\\-session/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPweek": "nxtPweek",
        "nxtPday": "nxtPday"
      },
      "namedRegex": "^/student/live\\-session/(?<nxtPweek>[^/]+?)/(?<nxtPday>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tutor/studio/[week]/[day]",
      "regex": "^/tutor/studio/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPweek": "nxtPweek",
        "nxtPday": "nxtPday"
      },
      "namedRegex": "^/tutor/studio/(?<nxtPweek>[^/]+?)/(?<nxtPday>[^/]+?)(?:/)?$"
    }

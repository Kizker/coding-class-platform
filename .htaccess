<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Route build assets to public/build
    RewriteRule ^build/(.*)$ public/build/$1 [L]

    # 2. If requested file or directory exists in root, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route everything else to root index.php
    RewriteRule ^ index.php [L]
</IfModule>
